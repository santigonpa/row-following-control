<?xml version="1.0" ?>
<sdf version="1.8">

  <model name="row_robot">

    <!-- Posición inicial -->
    <pose>0 0 0.2 0 0 0</pose>

    <!-- ========================= -->
    <!-- Chasis                    -->
    <!-- ========================= -->

    <link name="chassis">

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.2333</ixx>
          <iyy>0.6833</iyy>
          <izz>0.8833</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
      </visual>

    </link>


    <!-- ========================= -->
    <!-- Rueda izquierda           -->
    <!-- ========================= -->

    <link name="left_wheel">

      <pose>0 0.32 -0.1 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.0025</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- ========================= -->
    <!-- Rueda derecha             -->
    <!-- ========================= -->

    <link name="right_wheel">

      <pose>0 -0.32 -0.1 1.5708 0 0</pose>

      <inertial>
        <mass>1.0</mass>
        <inertia>
          <ixx>0.005</ixx>
          <iyy>0.005</iyy>
          <izz>0.0025</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.08</length>
          </cylinder>
        </geometry>
      </visual>

    </link>


    <!-- ========================= -->
    <!-- Joint rueda izquierda     -->
    <!-- ========================= -->

    <joint name="left_wheel_joint" type="revolute">

      <parent>chassis</parent>
      <child>left_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>


    <!-- ========================= -->
    <!-- Joint rueda derecha       -->
    <!-- ========================= -->

    <joint name="right_wheel_joint" type="revolute">

      <parent>chassis</parent>
      <child>right_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

    </joint>

    <!-- ========================= -->
    <!-- Differential drive        -->
    <!-- ========================= -->

    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.64</wheel_separation>
      <wheel_radius>0.15</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

    </plugin>

  </model>

</sdf>
